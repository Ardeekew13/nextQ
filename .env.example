# MongoDB connection string - use MongoDB Atlas for production
# Format: mongodb+srv://user:password@cluster.mongodb.net/database?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/pickleq

# Secret used to sign organiser session JWTs
# CRITICAL: Generate a strong random 32+ character string in production
# Example: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-strong-random-string-min-32-chars

# Name of the http-only auth cookie
AUTH_COOKIE_NAME=pickleq_session

# Public base URL of the app, used to build shareable public links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node environment (development, production)
NODE_ENV=development
