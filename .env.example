# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/pickleq

# Secret used to sign organiser session JWTs - use a long random string in production
JWT_SECRET=change-this-to-a-long-random-string

# Name of the http-only auth cookie
AUTH_COOKIE_NAME=pickleq_session

# Public base URL of the app, used to build shareable public links
NEXT_PUBLIC_APP_URL=http://localhost:3000
