# Production Environment Configuration
# Copy this to .env.production.local and fill in actual values
# NEVER commit .env.production.local to git

# MongoDB - Use MongoDB Atlas for production
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/dbname?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/pickleq?retryWrites=true&w=majority

# JWT Secret - Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRITICAL: Use a different value than development
# CRITICAL: Store securely in your hosting platform's secret manager
# CRITICAL: Rotate every 90 days (this will require all users to re-login)
JWT_SECRET=your-production-jwt-secret-min-32-chars-generated-via-crypto

# Auth Cookie Name - Can be any value but keep it consistent
AUTH_COOKIE_NAME=pickleq_session

# Public Application URL - Must be your production domain with https://
# This is used to generate shareable links
NEXT_PUBLIC_APP_URL=https://your-production-domain.com

# Node Environment - Must be 'production' for security features to activate
# When production:
#   - GraphQL introspection is disabled
#   - Stack traces are hidden
#   - Secure cookie flag is enabled
#   - HSTS headers are sent
NODE_ENV=production

# Optional: Add these for enhanced logging and monitoring
# LOG_LEVEL=info
# SENTRY_DSN=your-sentry-dsn-for-error-tracking
